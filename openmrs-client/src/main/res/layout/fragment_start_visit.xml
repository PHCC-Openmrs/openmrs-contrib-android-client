<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:orientation="vertical">

            <!-- Visit location. The visit's start date/time is not asked here - it is recorded
                 as the moment "Start visit" is actually tapped (see StartVisitViewModel#startVisit),
                 not whenever this form happened to be opened. -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:layout_marginTop="0dp"
                android:text="@string/visit_location_label" />

            <Spinner
                android:id="@+id/visitLocationSpinner"
                style="@style/AppointmentSpinner" />

            <!-- Service(s) this visit is for -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:text="@string/visit_service_label" />

            <TextView
                android:id="@+id/visitServiceField"
                style="@style/AppointmentPickerField"
                android:layout_width="match_parent"
                android:text="@string/visit_service_hint" />

            <!-- Visit attributes (Punctuality, ...). Built at runtime from the configured
                 visit attribute types, the same way the web client's form does. -->
            <LinearLayout
                android:id="@+id/visitAttributesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:background="@color/cancel_button"
                    android:fontFamily="@font/montserrat"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:text="@string/dialog_button_cancel"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/submitButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/save_button"
                    android:fontFamily="@font/montserrat"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:text="@string/action_start_visit"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <View
        android:id="@+id/transparentScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/translucent_50_percent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
