<!-- One coded (concept-backed) visit attribute field on the start-visit form, e.g. Punctuality. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/attributeLabel"
        style="@style/AppointmentFieldLabel" />

    <Spinner
        android:id="@+id/attributeSpinner"
        style="@style/AppointmentSpinner" />

</LinearLayout>
