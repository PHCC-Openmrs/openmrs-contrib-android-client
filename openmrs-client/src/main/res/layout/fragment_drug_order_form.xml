<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:orientation="vertical">

            <!-- Drug (fixed - chosen on the previous screen) -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:layout_marginTop="0dp"
                android:text="@string/drug" />

            <TextView
                android:id="@+id/selectedDrugLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp" />

            <!-- Dose -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:text="@string/dose" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/doseEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rectangle_transparent_box"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/doseUnitsSpinner"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/admission_spinner" />
            </LinearLayout>

            <!-- Route -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:text="@string/route" />

            <Spinner
                android:id="@+id/routeSpinner"
                style="@style/AppointmentSpinner" />

            <!-- Frequency -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:text="@string/frequency" />

            <Spinner
                android:id="@+id/frequencySpinner"
                style="@style/AppointmentSpinner" />

            <!-- As needed -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/AppointmentFieldLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="0dp"
                    android:text="@string/as_needed" />

                <Switch
                    android:id="@+id/asNeededSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Duration -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:text="@string/duration" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/durationEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rectangle_transparent_box"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:padding="8dp"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/durationUnitsSpinner"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/admission_spinner" />
            </LinearLayout>

            <!-- Quantity to dispense -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:text="@string/quantity_to_dispense" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/quantityEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rectangle_transparent_box"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:padding="8dp"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/quantityUnitsSpinner"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/admission_spinner" />
            </LinearLayout>

            <!-- Number of refills -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:text="@string/number_of_refills" />

            <EditText
                android:id="@+id/numRefillsEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rectangle_transparent_box"
                android:importantForAutofill="no"
                android:inputType="number"
                android:padding="8dp"
                android:text="0"
                android:textSize="14sp" />

            <!-- Additional instructions -->
            <TextView
                style="@style/AppointmentFieldLabel"
                android:text="@string/additional_instructions" />

            <EditText
                android:id="@+id/dosingInstructionsEditText"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rectangle_transparent_box"
                android:gravity="top"
                android:hint="@string/add_comment"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:padding="8dp"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:background="@color/cancel_button"
                    android:fontFamily="@font/montserrat"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:text="@string/dialog_button_cancel"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/submitButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/save_button"
                    android:fontFamily="@font/montserrat"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="10dp"
                    android:text="@string/action_submit"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <View
        android:id="@+id/transparentScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/translucent_50_percent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
