<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/drugSearchEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle_transparent_box"
        android:hint="@string/drug_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:padding="8dp"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:id="@+id/resultsHeaderRow">

        <TextView
            android:id="@+id/resultsCountLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/clearResultsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drug_search_clear_results"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/emptyResultsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/empty_orders_list"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drugSearchResultsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp" />

</LinearLayout>
